{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix server --omit=dev && npm ci --prefix client --include=dev",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "regions": ["bom1"],
  "rewrites": [
    { "source": "/api(/.*)?", "destination": "/api/handler" },
    { "source": "/((?!api(?:/|$)|assets(?:/|$)|favicon\\.png$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api(/.*)?",
      "headers": [{ "key": "Vercel-CDN-Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
